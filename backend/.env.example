PORT=4000

DB_HOST=localhost
DB_PORT=3306
DB_USER=aapl_app
DB_PASSWORD=change_me
DB_NAME=aapl_platform
# For DigitalOcean managed MySQL: leave DB_SSL_CA unset to connect encrypted
# but unverified (fine for testing), or set it to a downloaded CA cert path
# for full verification. Never set DB_SSL=false against a DO cluster —
# they reject plain connections outright.
# DB_SSL_CA=./certs/do-ca-certificate.crt
DB_CONNECTION_LIMIT=10

JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=8h

# Comma-separated list of origins allowed to call this API (your frontend URL)
CORS_ORIGIN=http://localhost:5173

# Longest a single timer session is credited, in hours. A session left running
# longer is closed automatically at this length and flagged for manager review.
MAX_SESSION_HOURS=12

# Email copies of notifications. Leave SMTP_HOST empty to keep everything in-app.
# Which notifications are emailed is a setting (Administration > Settings).
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASSWORD=
# MAIL_FROM=AAPL Platform <no-reply@aapl.example>
# Public address of the web app, used for the "Open it" link in emails.
# APP_URL=https://platform.aapl.example

# Set to 1 when the API runs behind a reverse proxy such as Nginx (see README, Deployment).
# TRUST_PROXY=1

# Which batch of Version 1 is visible to users: 1 to 5 (see README, Rollout).
# Leave unset to switch everything on (development). Nothing in the application
# can change this; edit it here and restart the API.
# ROLLOUT_BATCH=1
